# Directory holding the documents to index (.md, .txt, .rst), read at startup.
RAG_CORPUS_DIR=corpus
# Words per retrieval chunk.
RAG_CHUNK_SIZE=180
# Words repeated between consecutive chunks. Must be smaller than RAG_CHUNK_SIZE.
RAG_CHUNK_OVERLAP=40
# Default number of passages returned by search_documents.
RAG_TOP_K=5
# Files larger than this are skipped and reported by list_documents.
RAG_MAX_FILE_BYTES=2000000
